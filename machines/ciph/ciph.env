
SESSION_TYPE="multi-user"
# CONTAINER_STATE="disable"
CONTAINER_HOSTNAME="csph"
CONTAINER_MAC_ADDRESS=""
PARTITION_TABLE_TYPE="gpt"
SUBVOLUME_COMPRESSION_ALGORITHM="zstd"

# ${2}=part_num|part_type|part_label|part_start|part_end
DISK_PARTITION="\
1|vfat|SYSBOOT|1024KiB|525312KiB
2|btrfs|SYSROOT|525312KiB|$(( $(adapter_get_disk_size "${2}") - $(adapter_get_memory_size) ))KiB
3|swap|MEMSWAP|$(( $(adapter_get_disk_size "${2}") - $(adapter_get_memory_size) ))KiB|100%
"

ROOT_PARTITION_NUMBER=*$(printf '%s' "${DISK_PARTITION}" | grep -n "SYSROOT" | cut --delimiter='|' --fields=1)

NEW_SUBVOLUME="@ @home @var"

BASE_RPM_PACKAGE="openSUSE-release shadow systemd systemd-networkd sysconfig-netconfig iproute2 iputils ca-certificates-mozilla glibc-locale procps psmisc libdrm_amdgpu1 libdrm_intel1 Mesa-dri Mesa-libva libva-utils"

UNINSTALL_PACKAGE="wicked wicked-service"

