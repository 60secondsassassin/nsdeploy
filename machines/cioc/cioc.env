
SESSION_TYPE="multi-user"
CONTAINER_STATE="enable"
CONTAINER_HOSTNAME="csoc"
CONTAINER_MAC_ADDRESS="62:10:C5:00:11:23"

INSTALL_PACKAGE_NAME="
apache2-event apache2-utils avif-tools exiftool ffmpeg ImageMagick krb5 libheif-aom libheif-dav1d libheif-ffmpeg libheif-rav1e \  openssl php7 php7-APCu php7-cli php7-ctype php7-curl php7-dom php7-exif php7-fileinfo php7-fpm php7-ftp php7-gd php7-gmp php7-iconv php7-imagick php7-intl php7-json php7-ldap php7-mbstring php7-mysql php7-opcache php7-openssl php7-phar php7-pcntl php7-posix php7-sodium php7-sysvsem php7-redis php7-ssh2 php7-xmlreader php7-xmlwriter php7-zip php7-zlib python3-certbot python3-certbot-apache redis sudo libdrm_amdgpu1 Mesa-dri Mesa-libva libva-utils
"

UNINSTALL_PACKAGE_NAME="
"

ARCHIVE_PATH="
/storage/persistent/owncloud/owncloud-complete-20260218.tar.bz2|/srv/www/htdocs/
"

USER_NAME="
kodi|Kodi Media Player|/storage/emulated/0/Android/data/org.xbmc.kodi/files/
"

GROUP_NAME="
wwwrun|redis
"

DIRECTORY_PATH="
/srv/www/htdocs/owncloud/data|0750|wwwrun|wwwrun
/var/log/owncloud|0755|wwwrun|wwwrun
"

EDIT_CONFIG_VALUE="
/etc/systemd/network/00-host0.network|MACAddress=.*|MACAddress=${CONTAINER_MAC_ADDRESS}
/etc/php7/cli/php.ini|memory_limit = 128M|memory_limit = 1024M
/etc/php7/cli/php.ini|\;opcache.interned_strings_buffer=8|opcache.interned_strings_buffer=64
"

REMOVE_CONFIG_VALUE="
/etc/apache2/loadmodule.conf|cgi_module
"

ENABLE_SERVICE_NAME="
apache2.service owncloudcron.timer php-fpm.service redis@sessions.service redis@cache.service
"

DISABLE_SERVICE_NAME="
"

ENABLE_APACHE_MODULE_NAME="
ssl headers rewrite http2 proxy proxy_fcgi proxy_http socache_shmcb mpm_event
"

DISABLE_APACHE_MODULE_NAME="
php7 mpm_prefork
"

VOLUME_PATH="
/storage/data/owncloudData|/srv/www/htdocs/owncloud/data
/storage/persistent/owncloud/apps-external|/srv/www/htdocs/owncloud/apps-external
/storage/persistent/owncloud/config.php|/srv/www/htdocs/owncloud/config/config.php
/storage/persistent/owncloud/mimetypemapping.json|/srv/www/htdocs/owncloud/config/mimetypemapping.json
/storage/persistent/owncloud/cert/letsencrypt|/etc/letsencrypt
/dev/shm|/dev/shm
/dev/dri|/dev/dri
/etc/resolv.conf|/etc/resolv.conf
"
