APP_NAME="no_name_yet"
VERSION="0.0.1 Alpha"

RED='\033[0;31m'
# GREEN='\033[0;32m'
# BLUE='\033[0;34m'
NC='\033[0m'


TEMPLATE_NAME="cibz"
IMAGES_DIR="/var/lib/machines"
CONFIG_DIR="/etc/systemd/nspawn"
CONFIG_TYPE="conf"
LOG_FILE="${ENVIRONEMENT_PATH}/deploy.log"
CONTAINER_CONFIG_PATH="${ENVIRONEMENT_PATH}/machines/${IMAGE_NAME}/configs"
DROPIN_DIRECTORY_PATH="/etc/systemd/system/systemd-nspawn@${IMAGE_NAME}.service.d"
HOSTNAME_FILE="/etc/hostname"

DISK_ATTACHMENT="/dev"

COMMANDS="\
--new|method_new_image
--edit|method_edit_image
--help|command_show_usage
"

TEMPLATE_NSPAWN="\
[Exec]
Boot=Yes
Ephemeral=Yes
PrivateUsers=No
LinkJournal=No

[Files]

[Network]
# Bridge=br0
VirtualEthernet=No
"

SCRIPT_OPTION="\
${APP_NAME} v ${VERSION}

Usage: $(basename ${0}) [options] [image_name]

Options :
  --new       Reconstruit l'image puis configure
  --edit      Configure l'image existante
  --help      Affiche cette aide
"
